# HTTP/HTTPS 端口，可按 NAS 上的端口占用情况自定义
WEB_HTTP_PORT=26665
WEB_HTTPS_PORT=26666

# 浏览器访问 NAS 使用的 IP 或内网域名；HTTPS 证书将为此地址签发
TLS_HOST=192.168.0.111

# 管理令牌。请替换成随机长字符串，Web 服务拒绝空令牌启动。
APP_TOKEN=replace-with-a-long-random-admin-token
# 首次令牌接口默认关闭；仅在受信任局域网临时初始化时改为 true
ALLOW_INITIAL_TOKEN_ENDPOINT=false

# LAN 扫描名称和网卡
AGENT_NAME=home-lan-agent
SCAN_INTERFACE=eth0

# 从 Docker Hub 拉取的统一应用镜像
NETWAKE_IMAGE=azheng95/netwake:1.0.0

# 默认扫描网段
DEFAULT_CIDR=192.168.0.0/24
